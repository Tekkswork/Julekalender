<%- include('partials/header') %>

<form class="login-div" action="/login" method="POST">

<h1>Julekalender</h1>
<p class="loginP">Logg inn for å åpne dagens luke</p>

<label for="name">Navn</label>
<input id="name" name="name" type="text">

<label for="surname">Etternavn</label>
<input id="surname" name="surname" type="text">


<label for="email">Skole E-post</label>
<input id="email" name="email" type="email">

<button class="login-submit" type="submit">Logg inn</button>
<button class="admin-login" type="submit">Logg inn som admin</button>

</form>

<%- include('partials/footer', { footerClass: 'footer footer-login' }) %>
